<% layout("/layouts/boilerplate.ejs") %>

<style>
@media (max-width:750px){
.container-fluid{padding-top:280px!important;}
}

body{
background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);
min-height:100vh;
font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
}

.main-content{
background:white;
border-radius:16px;
padding:24px 28px;
box-shadow:0 10px 30px rgba(0,0,0,0.12);
}

.table-bordered th{
background:linear-gradient(135deg,#0d6efd,#0b5ed7);
color:white;
}
</style>

<div class="container-fluid" style="padding-top:170px;">
<div class="row">

<%- include("partials/sidebar") %>

<div class="col-md-10 p-4 main-content">

<h2>Order Details</h2>

<table class="table table-bordered mt-3">
<tr><th>Name</th><td><%= order.name %></td></tr>
<tr><th>Phone</th><td><%= order.phone %></td></tr>
<tr><th>Address</th><td><%= order.address %></td></tr>
<tr><th>Status</th><td><%= order.status %></td></tr>
<tr><th>Date</th><td><%= order.createdAt.toDateString() %></td></tr>
</table>


<h4 class="mt-4">Products</h4>

<form action="/admin/orders/<%= order._id %>/update-amounts" method="POST">

<% if(order.products && order.products.length>0){ %>

<table id="productsTable" class="table table-bordered table-striped">

<thead>
<tr>
<th>Product</th>
<th>Quantity</th>
<th>Price</th>
<th>Total</th>
</tr>
</thead>

<tbody>

<% order.products.forEach((p,i)=>{ %>

<tr>

<td><%= p.name %></td>

<td class="qty"><%= p.quantity %></td>

<td>
<input type="number"
class="form-control price"
name="price[]"
value="<%= p.price || 0 %>">
</td>

<td>
<input type="number"
class="form-control rowTotal"
name="rowTotal[]"
value="<%= p.rowTotal || 0 %>">
</td>

</tr>

<% }) %>

</tbody>
</table>

<% }else{ %>

<p>No products found</p>

<% } %>


<a href="/admin/orders" class="btn btn-secondary mt-3">
⬅ Back to Orders
</a>


<div class="mt-4 p-4 border rounded bg-light">

<h4 class="mb-3">Update Order Amounts</h4>

<div class="row g-3">

<div class="col-md-6">
<label>Subtotal</label>
<input type="number"
name="subTotal"
value="<%= order.subTotal || 0 %>"
class="form-control"
readonly>
</div>

<div class="col-md-6">
<label>GST (%)</label>
<input type="number"
name="gst"
value="<%= order.gst || 0 %>"
class="form-control">
</div>

<div class="col-md-6">
<label>Delivery Charges</label>
<input type="number"
name="deliveryCharges"
value="<%= order.deliveryCharges || 0 %>"
class="form-control">
</div>

<div class="col-md-6">
<label>Discount</label>
<input type="number"
name="discount"
value="<%= order.discount || 0 %>"
class="form-control">
</div>

<div class="col-md-6">
<label>Total Amount</label>
<input type="number"
name="totalAmount"
value="<%= order.totalAmount || 0 %>"
class="form-control"
readonly>
</div>

</div>

<button type="submit" class="btn btn-primary mt-3">
💾 Save Amounts
</button>

</div>

</form>


<a href="/admin/orders/<%= order._id %>/invoice"
target="_blank"
class="btn btn-info mt-3">
📄 Generate Invoice
</a>


</div>
</div>
</div>

<script>

function recalc(){

let rows=document.querySelectorAll("#productsTable tbody tr")
let subTotal=0

rows.forEach(row=>{

let qtyText=row.querySelector(".qty").innerText

// quantity मधून number काढतो
let qty=parseFloat(qtyText.replace(/[^0-9.]/g,''))||1

let price=parseFloat(row.querySelector(".price").value)||0
let totalInput=row.querySelector(".rowTotal")

// auto total only if manual नाही
if(!totalInput.dataset.manual){

let total=qty*price
totalInput.value=total.toFixed(2)

}

subTotal+=parseFloat(totalInput.value)||0

})

document.querySelector("input[name='subTotal']").value=subTotal.toFixed(2)

let gst=parseFloat(document.querySelector("input[name='gst']").value)||0
let delivery=parseFloat(document.querySelector("input[name='deliveryCharges']").value)||0
let discount=parseFloat(document.querySelector("input[name='discount']").value)||0

let gstAmount=(subTotal*gst)/100
let final=subTotal+gstAmount+delivery-discount

document.querySelector("input[name='totalAmount']").value=final.toFixed(2)

}


// price change
document.querySelectorAll(".price").forEach(inp=>{
inp.addEventListener("input",()=>{
inp.closest("tr").querySelector(".rowTotal").dataset.manual=""
recalc()
})
})


// manual total change
document.querySelectorAll(".rowTotal").forEach(inp=>{
inp.addEventListener("input",()=>{
inp.dataset.manual="true"
recalc()
})
})


// gst delivery discount
document.querySelectorAll("input[name='gst'],input[name='deliveryCharges'],input[name='discount']").forEach(inp=>{
inp.addEventListener("input",recalc)
})


recalc()

</script>